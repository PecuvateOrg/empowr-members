# Supabase â€” empowr-cic project (qrdlheqnnzpasbnayalm)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=

# Web Push (member messaging phone alerts). All optional: with the keys unset, push is a quiet no-op and
# messages still go by email and in the inbox. Generate a pair once with web-push's generateVAPIDKeys();
# keep the private key in the Vault/Netlify, never in the repo.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bookings@empowrcic.org

# Brevo â€” operational session communications only (server-side)
BREVO_API_KEY=
# Empowr Members is permanently list 17; optional override if replaced later.
# Optional: BREVO_MEMBERS_LIST_ID=17
# Permanent list IDs 7â€“16 are configured in lib/brevo.ts. Optional
# BREVO_*_LIST_ID environment overrides can replace individual IDs later.

# Admin allowlist (comma-separated emails)
ADMIN_EMAILS=
CHECKIN_EMAILS=


# Extra sign-in methods - each OFF until its provider/passkey config exists (see lib/auth-providers.ts)
NEXT_PUBLIC_AUTH_PROVIDERS=
NEXT_PUBLIC_PASSKEYS_ENABLED=false
